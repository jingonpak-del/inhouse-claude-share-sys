# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 GitHub 에 올리지 않는다.

# Claude 월구독 토큰 — 터미널에서 `claude setup-token` 실행 후 나온 sk-ant-oat… 값 (1년 유효)
CLAUDE_CODE_OAUTH_TOKEN=

# config.json 의 claude_backend 를 "api" 로 바꿀 때만 사용 (사용량 과금)
ANTHROPIC_API_KEY=

# 계정별 인스타·스레드 토큰 — 이름은 <config.json accounts 의 키 대문자>_INSTAGRAM_ACCESS_TOKEN 형식
# Meta 개발자 앱에서 발급 (README '계정 연결' 참고). 계정 하나에 채널 하나씩.

# 더줌 (thezum) — 예전 이름 INSTAGRAM_ACCESS_TOKEN / THREADS_ACCESS_TOKEN 도 그대로 읽힌다
THEZUM_INSTAGRAM_ACCESS_TOKEN=
THEZUM_THREADS_ACCESS_TOKEN=

# 뷰티인포 (beautyinfo)
BEAUTYINFO_INSTAGRAM_ACCESS_TOKEN=
BEAUTYINFO_THREADS_ACCESS_TOKEN=

# 지역정보 (localinfo)
LOCALINFO_INSTAGRAM_ACCESS_TOKEN=
LOCALINFO_THREADS_ACCESS_TOKEN=
