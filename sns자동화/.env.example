# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 GitHub 에 올리지 않는다.

# Claude 월구독 토큰 — 터미널에서 `claude setup-token` 실행 후 나온 sk-ant-oat… 값 (1년 유효)
CLAUDE_CODE_OAUTH_TOKEN=

# config.json 의 claude_backend 를 "api" 로 바꿀 때만 사용 (사용량 과금)
ANTHROPIC_API_KEY=

# Meta 개발자 앱에서 발급 (README 2)·3) 참고)
INSTAGRAM_ACCESS_TOKEN=
THREADS_ACCESS_TOKEN=
