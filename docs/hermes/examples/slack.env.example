# 프로필별 비밀값 파일 예시
# 위치: ~/.hermes/profiles/<프로필명>/.env
#   (기본 프로필은 ~/.hermes/.env)
# 파일 권한은 600으로. git에 커밋하지 말 것.

# ── 엔진 (Claude) ─────────────────────────────────────────────
# 회사 상시 운영은 API 키 방식을 권장한다(조직 단위 과금·한도 관리 가능).
# Claude Max + 추가 사용량 크레딧이 있으면 `hermes model`의 OAuth 경로도 쓸 수 있다.
ANTHROPIC_API_KEY=sk-ant-...

# ── 슬랙 ──────────────────────────────────────────────────────
# Bot User OAuth Token (Install App 화면)
SLACK_BOT_TOKEN=xoxb-...

# App-Level Token (Socket Mode 켤 때 생성, connections:write 스코프)
SLACK_APP_TOKEN=xapp-...

# 이 봇에게 말을 걸 수 있는 사람들의 슬랙 멤버 ID (쉼표 구분).
# ★ 비워 두면 게이트웨이가 안전장치로 모든 메시지를 거부한다.
#   멤버 ID 확인: 프로필 → ⋮ → Copy member ID
SLACK_ALLOWED_USERS=U01ABC2DEF3,U02XYZ4GHI5

# 크론/칸반 알림 등 예약 발송의 기본 채널
SLACK_HOME_CHANNEL=C0123456789
SLACK_HOME_CHANNEL_NAME=디자인

# 선택: 응답할 채널을 고정 (config.yaml의 slack.allowed_channels와 동일 효과)
# SLACK_ALLOWED_CHANNELS=C0123456789,C0987654321

# 선택: 다른 봇 메시지 수락 정책 — none(기본) | mentions | all
# 에이전트끼리 대화시킬 때만 mentions로. all은 무한 루프 위험.
# SLACK_ALLOW_BOTS=mentions

# ── 절대 켜지 말 것 ───────────────────────────────────────────
# GATEWAY_ALLOW_ALL_USERS=true    # 워크스페이스 누구나 에이전트를 조작할 수 있게 된다
